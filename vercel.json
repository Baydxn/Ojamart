{
  "rewrites": [
    {
      "source": "/admin/(.*)",
      "destination": "/admin"
    },
    {
      "source": "/admin",
      "destination": "/admin"
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}